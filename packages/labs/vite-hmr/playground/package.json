{
  "name": "vite-hmr-playground",
  "description": "Playground for the Lit HMR Vite plugin — self-contained so it can be opened on StackBlitz/bolt.new straight from the repo URL",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite"
  },
  "dependencies": {
    "@lit-labs/signals": "^0.3.0",
    "@lit-labs/virtualizer": "^2.1.1",
    "@lit/context": "^1.1.6",
    "@lit/task": "^1.0.3",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@oddsquad/vite-plugin-lit": "^0.0.3",
    "vite": "^7.3.5"
  },
  "stackblitz": {
    "installDependencies": true,
    "startCommand": "npm run dev"
  }
}
